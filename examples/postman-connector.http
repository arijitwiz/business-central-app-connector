# Same OAuth as Business Central V2 (client_credentials).
# Scope: https://api.businesscentral.dynamics.com/.default

@baseUrl = https://api.businesscentral.dynamics.com/v2.0/{{tenantId}}/{{environment}}
@companyId = {{companyId}}
@accessToken = {{accessToken}}

### 1) Standard API sanity check
GET {{baseUrl}}/api/v2.0/companies
Authorization: Bearer {{accessToken}}

### 2) GET ship-to addresses
GET {{baseUrl}}/api/wizcommerce/connector/v1.0/companies({{companyId}})/wizShipToAddresses?$top=10
Authorization: Bearer {{accessToken}}

### 3) Ship-to filter by customer
GET {{baseUrl}}/api/wizcommerce/connector/v1.0/companies({{companyId}})/wizShipToAddresses?$filter=customerNumber eq '10000'
Authorization: Bearer {{accessToken}}

### 4) POST ship-to
POST {{baseUrl}}/api/wizcommerce/connector/v1.0/companies({{companyId}})/wizShipToAddresses
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "customerNumber": "10000",
  "code": "TEST",
  "name": "Test Warehouse",
  "address": "123 Test Street",
  "city": "Dallas",
  "postalCode": "75001",
  "country": "US"
}

### 5) PATCH ship-to (use id from GET/POST response)
PATCH {{baseUrl}}/api/wizcommerce/connector/v1.0/companies({{companyId}})/wizShipToAddresses({{shipToId}})
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Updated Warehouse Name"
}
