{
  "scope": "https://api.businesscentral.dynamics.com/.default",
  "tenant_id": "aaf26c70-a831-4c8b-a0ad-35e35f29f7af",
  "client_id": "YOUR_CLIENT_ID",
  "client_secret": "YOUR_CLIENT_SECRET",
  "environment": "Sandbox",
  "company_id": "c6a9170d-f7bb-f111-85be-7ced8d9daf2f",
  "buyer": {
    "sub_entities": true,
    "sub_entity_list": [
      {
        "name": "shipping_addresses",
        "endpoint": "/api/wizcommerce/connector/v1.0/companies({company_id})/wizShipToAddresses",
        "filter_field": "customerNumber",
        "pull": true,
        "push": true,
        "batch_size": 50,
        "pagination_type": "skip"
      },
      {
        "name": "price_list",
        "endpoint": "/api/wizcommerce/connector/v1.0/companies({company_id})/wizCustomerPrices",
        "filter_field": "customerNumber",
        "pull": true,
        "push": false
      }
    ]
  },
  "shipment": {
    "sub_entities": true,
    "sub_entity_list": [
      {
        "name": "tracker",
        "endpoint": "/api/wizcommerce/connector/v1.0/companies({company_id})/wizShipmentTrackings",
        "filter_field": "shipmentNumber",
        "pull": true,
        "push": false
      }
    ]
  },
  "inventory": {
    "endpoint": "/api/wizcommerce/connector/v1.0/companies({company_id})/wizItemAvailabilities",
    "entity_filter": "itemNo",
    "date_filter_field": "lastModifiedDateTime",
    "reference_id_field": "itemNo"
  }
}
